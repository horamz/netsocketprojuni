# Ignore Visual Studio temporary files, build results, and
# user-specific files

## Build results
bin/
obj/
out/

## User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

## Mono Auto Generated Files
mono_crash.*

## Windows image file caches
Thumbs.db
ehthumbs.db

## Folder config file
Desktop.ini

## Recycle Bin used on file shares
$RECYCLE.BIN/

## VS Code settings folder
.vscode/

## Visual Studio working files
.vs/

# Ignore JetBrains Rider IDE files
.idea/
*.iml

# Ignore StyleCop settings and logs
StyleCop.Cache

# Ignore NCrunch files
_ncrunch_*
*.ncrunchsolution

# Ignore Azure DevOps Pipeline logs
pipelines.log

# Ignore coverage reports generated by tools like Coverlet or dotCover
coverage/
*.coverage
*.coveragexml

# Ignore test result files generated by Visual Studio Test Explorer or NUnit/XUnit/MSTest runners.
TestResult/
*.trx

# Ignore NuGet Packages folder and lock files
packages/
*.nupkg.lock

# Ignore logs and debug output
*.log

# Ignore temporary files created by MSBuild or other build tools.
*_tmp/

# Ignore IDE-specific folders for JetBrains Rider or Visual Studio Code extensions.
.idea/
.vscode/

# Ignore global settings for Git repositories on Windows.
.gitconfig.local

# Ignore generated database migration scripts or backups.
migrations/
backups/

# Ignore node_modules (if using JavaScript/TypeScript in the project)
node_modules/


